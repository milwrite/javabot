DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=1436782482967101491
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=milwrite
GITHUB_REPO_NAME=javabot
GITHUB_REPO_URL=https://github.com/milwrite/javabot/
CHANNEL_ID=your_dedicated_channel_id
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_FALLBACK=your_fallback_openrouter_api_key

# Deep Research provider and completion safeguards. "auto" prefers native
# Perplexity when PERPLEXITY_API_KEY exists and otherwise uses OpenRouter.
DEEP_RESEARCH_PROVIDER=auto
PERPLEXITY_API_KEY=your_perplexity_api_key
DEEP_RESEARCH_MAX_TOKENS=32768
DEEP_RESEARCH_REASONING_EFFORT=medium
DEEP_RESEARCH_TIMEOUT_MS=720000
DEEP_RESEARCH_MAX_ATTEMPTS=2
PUBLIC_SITE_BASE_URL=https://bot.inference-arcade.com
DEEP_RESEARCH_ARCHIVE_URL=https://bot.inference-arcade.com/src/search/index.html
REMOTE_RESEARCH_ARCHIVE=true
KEEP_HTTP_ON_DISCORD_FAILURE=true

# Optional: PostgreSQL for long-term logging
DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Use modular prompt system (set to false to use legacy systemPrompt.js)
USE_MODULAR_PROMPTS=true
